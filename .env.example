# ============================================================================
# Agentic Student OS - environment template
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real secrets.
# PR 0 declares these; most are UNUSED until the PR that introduces them.
# ============================================================================

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Backend (TS orchestrator) ----
BACKEND_PORT=3000
# Loopback by default. Set 0.0.0.0 only where you intend to expose all interfaces.
BACKEND_HOST=127.0.0.1

# ---- Inference service (Python) ----
INFERENCE_PORT=8000
# URL the backend uses to reach the inference service.
INFERENCE_SERVICE_URL=http://localhost:8000

# ---- Database (Supabase / Postgres) — DECLARED ONLY, unused until PR 1 ----
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---- External providers — DECLARED ONLY, unused until their PR ----
# CANVAS_BASE_URL=            # PR 4
# CANVAS_API_TOKEN=           # PR 4 (fallback direct API)
# COMPOSIO_API_KEY=           # PR 4 / PR 17
# INNGEST_EVENT_KEY=          # PR 3
# INNGEST_SIGNING_KEY=        # PR 3
# DEEPGRAM_API_KEY=           # PR 9
# MODAL_TOKEN_ID=             # PR 12
# MODAL_TOKEN_SECRET=         # PR 12
