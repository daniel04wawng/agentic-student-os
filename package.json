{
  "name": "agentic-student-os",
  "private": true,
  "version": "0.0.0",
  "description": "Agentic Student OS - monorepo root (PR 0 skeleton).",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "shared:generate": "npm run generate -w @student-os/shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.6"
  }
}
